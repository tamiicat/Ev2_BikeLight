<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- visualizar contacto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFichaContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/bikelight_sos_dark" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información de Contacto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvDisplayContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre: No registrado"
                    android:textColor="@color/white"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDisplayContactPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono: No registrado"
                    android:textColor="@color/white"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDisplayContactEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo: No registrado"
                    android:textColor="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- actualizar datos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar Contacto"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/bikelight_sos_dark"
            android:layout_marginBottom="12dp" />

        <!-- nombre contacto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmergencyContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Nombre"
            app:expandedHintEnabled="false"
            android:textColorHint="@color/bikelight_sos_dark"
            app:hintTextColor="@color/bikelight_sos_dark"
            app:boxStrokeColor="@color/bikelight_sos_dark"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Alonso Díaz"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- teléfono contacto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmergencyContactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Teléfono de Emergencia"
            app:expandedHintEnabled="false"
            android:textColorHint="@color/bikelight_sos_dark"
            app:hintTextColor="@color/bikelight_sos_dark"
            app:boxStrokeColor="@color/bikelight_sos_dark"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyContactPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. +56912345678"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- correo electrónico -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmergencyContactEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Correo Electrónico"
            app:expandedHintEnabled="false"
            android:textColorHint="@color/bikelight_sos_dark"
            app:hintTextColor="@color/bikelight_sos_dark"
            app:boxStrokeColor="@color/bikelight_sos_dark"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeWidth="1dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyContactEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. contacto@gmail.com"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- botón -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveContact"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:backgroundTint="@color/bikelight_sos_dark"
            android:text="Guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>