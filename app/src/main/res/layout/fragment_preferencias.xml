<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true"
    android:background="@color/bikelight_bg">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- tema aplicación -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTemaApp"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="15dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bikelight_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Tema\nAplicación"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- configuración unidades de medidas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUnidadesMedida"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="15dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bikelight_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Unidades de\nMedida"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- modo ahorro energía -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAhorroEnergia"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="15dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bikelight_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Modo Ahorro\nEnergía"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- configuración msj SOS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBorrarCache"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="15dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bikelight_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Borrado de Caché"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- borrar caché -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConfigMensajeSos"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="15dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bikelight_sos">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Configuración Mensaje SOS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>
</ScrollView>