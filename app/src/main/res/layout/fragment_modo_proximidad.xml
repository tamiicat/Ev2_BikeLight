<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Modo Proximidad"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/bikelight_text_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvModoSeleccionado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Modo activo: Cargando..."
            android:textSize="14sp"
            android:textColor="@color/bikelight_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins">

            <!-- Carretera -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModoCarretera"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/bikelight_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carretera"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvDescCarretera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rango largo (4m)\nAlerta anticipada"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ciclovía -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModoCiclovia"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciclovía"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvDescCiclovia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rango corto (1m)\nFiltro adelantamientos"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ciudad -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModoCiudad"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ciudad"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvDescCiudad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rango medio (2m)\nTráfico continuo"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nocturno -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModoNocturno"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/bikelight_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nocturno"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvDescNocturno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brillo LED máximo\nAlerta sonora alta"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </LinearLayout>
</ScrollView>