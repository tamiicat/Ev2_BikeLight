<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bikelight_bg"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- estado actual -->
        <TextView
            android:id="@+id/tvUnidadSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"
            android:text="Sistema activo: Métrico (km/h, m)"
            android:textColor="@color/bikelight_text_dark" />

        <!-- sistema métrico -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetrico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/bikelight_card"
            app:cardBackgroundColor="@color/bikelight_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistema Métrico Internacional"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Distancia: Metros (m) / Kilómetros (km)\n• Velocidad: km/h\n• Proximidad del sensor: Centímetros (cm)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- sistema emperial -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImperial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:strokeColor="@color/bikelight_card"
            app:cardBackgroundColor="@color/bikelight_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistema Imperial"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Distancia: Pies (ft) / Millas (mi)\n• Velocidad: mph\n• Proximidad del sensor: Pulgadas (in)"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarUnidades"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Guardar Preferencia"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/bikelight_card" />
    </LinearLayout>
</ScrollView>