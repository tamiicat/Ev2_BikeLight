<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bikelight_bg">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFichaLed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bikelight_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración Activa"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvDisplayColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colores: No registrado"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvDisplayEfecto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Efecto: No registrado"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvDisplayBrillo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nivel de Brillo: No registrado"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar Configuración"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/bikelight_primary"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvLabelColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patrón de Color"
                android:textColor="@color/bikelight_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">

                <Spinner
                    android:id="@+id/spinnerLedColors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="@color/bikelight_card_dark" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvEffectColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Efecto Visual"
                android:textColor="@color/bikelight_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">

                <Spinner
                    android:id="@+id/spinnerEffectColors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="@color/bikelight_card_dark" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Control de Brillo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvLabelBrillo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Brillo"
                    android:textColor="@color/bikelight_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvValorBrilloActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="@color/bikelight_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/bikelight_primary"
                android:thumbTint="@color/bikelight_primary_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarLed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:backgroundTint="@color/bikelight_card"
                android:text="Guardar Configuración"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvLabelModoManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Manual"
                android:textColor="@color/bikelight_primary_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivarLed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:backgroundTint="@color/bikelight_primary"
                android:text="Activar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDesactivarLed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:backgroundTint="@color/bikelight_card_dark"
                android:text="Desactivar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>