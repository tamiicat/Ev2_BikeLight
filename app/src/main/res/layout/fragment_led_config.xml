<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bikelight_bg">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- color -->
            <TextView
                android:id="@+id/tvLabelColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textColor="@color/bikelight_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">

                <Spinner
                    android:id="@+id/spinnerLedColors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="@color/bikelight_card_dark" />
            </com.google.android.material.card.MaterialCardView>

            <!-- color -->
            <TextView
                android:id="@+id/tvEffectColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Efecto"
                android:textColor="@color/bikelight_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bikelight_card_dark">

                <Spinner
                    android:id="@+id/spinnerEffectColors"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:popupBackground="@color/bikelight_card_dark" />
            </com.google.android.material.card.MaterialCardView>

            <!-- brillo -->
            <TextView
                android:id="@+id/tvLabelBrillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Brillo"
                android:textColor="@color/bikelight_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/bikelight_primary"
                android:thumbTint="@color/bikelight_primary_dark" />

            <!-- modo manual -->
            <TextView
                android:id="@+id/tvLabelModoManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Modo Manual"
                android:textColor="@color/bikelight_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- activar leds -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivarLed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                app:backgroundTint="@color/bikelight_primary"
                android:text="Activar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- desactivar leds -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDesactivarLed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/bikelight_card"
                android:text="Desactivar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>